//@version=6
indicator("Trade Knowledge Foundation 0.12.0", overlay = false, precision = 12)

// TK_CORE_BEGIN - the fixture generator uses this exact source block.
// Integer sign comparisons avoid Pine's nine-fractional-digit float comparisons.
tk_cmp(float x, float y) =>
    int(math.sign(x - y))
tk_snap(float x, float boundary) =>
    tk_cmp(math.abs(x - boundary), 1e-9) <= 0 ? boundary : x
tk_delta(float a, float b, float quantum) =>
    math.round((a - b) / quantum) * quantum
tk_on_grid(float price, float quantum) =>
    float units = price / quantum
    tk_cmp(math.abs(units - math.round(units)), math.max(1e-9, math.abs(units) * 4e-16)) <= 0

type TKState
    int count = 0
    float previous = na
    float sum = 0.0
    float atr = na
    float weight = na
type TKRow
    float tr = na
    float atr = na
    float baseline = na
    float span = na
    float body = na
    float upper = na
    float lower = na
    float seed = na
    float raw = na
    float comp = na
    float bf = na
    float cl = na
    int length = -1
    int dominant = -1
    int pin = -1

tk_step(TKState s, int n, float quantum, float o, float h, float l, float c) =>
    TKRow r = TKRow.new()
    if n < 1 or n > 5000 or na(quantum) or tk_cmp(quantum, 0.0) <= 0 or na(o) or na(h) or na(l) or na(c) or tk_cmp(l, 0.0) <= 0 or tk_cmp(h, l) < 0 or tk_cmp(o, l) < 0 or tk_cmp(o, h) > 0 or tk_cmp(c, l) < 0 or tk_cmp(c, h) > 0 or tk_cmp(h / quantum, 1e14) > 0
        runtime.error("Invalid period or OHLC; history must not skip this bar")
    if not tk_on_grid(o, quantum) or not tk_on_grid(h, quantum) or not tk_on_grid(l, quantum) or not tk_on_grid(c, quantum)
        runtime.error("OHLC does not match the declared price quantum")
    r.span := tk_delta(h, l, quantum)
    r.body := math.abs(tk_delta(c, o, quantum))
    r.upper := tk_delta(h, math.max(o, c), quantum)
    r.lower := tk_delta(math.min(o, c), l, quantum)
    r.baseline := s.atr
    r.seed := s.weight
    if not na(s.previous)
        r.tr := math.max(r.span, math.max(math.abs(tk_delta(h, s.previous, quantum)), math.abs(tk_delta(l, s.previous, quantum))))
        if not na(s.atr)
            s.atr := ((n - 1) * s.atr + r.tr) / n
            s.weight := s.weight * (n - 1) / n
        else
            s.sum := s.sum + r.tr
            s.count := s.count + 1
            if s.count == n
                s.atr := s.sum / n
                s.weight := 1.0
    s.previous := c
    r.atr := s.atr
    if tk_cmp(r.span, 0.0) == 0
        if not na(r.baseline) and tk_cmp(r.baseline, 0.0) > 0
            r.raw := 0.0
            r.comp := 0.0
        r.length := 0
        r.dominant := 0
        r.pin := 0
    else
        r.bf := r.body / r.span
        r.cl := tk_delta(c, l, quantum) / r.span
        if not na(r.baseline) and tk_cmp(r.baseline, 0.0) > 0
            r.raw := r.span / r.baseline
            r.comp := tk_snap(tk_snap(tk_snap(r.raw, 0.8), 1.2), 2.5)
            r.length := tk_cmp(r.comp, 0.8) < 0 ? 1 : (tk_cmp(r.comp, 1.2) <= 0 ? 2 : (tk_cmp(r.comp, 2.5) <= 0 ? 3 : 4))
            float part = math.max(r.body, math.max(r.upper, r.lower)) / r.span
            r.dominant := r.length == 2 and tk_cmp(tk_snap(part, 0.8), 0.8) >= 0 ? 1 : 0
            bool top = tk_cmp(tk_snap(r.lower / r.span, 0.8), 0.8) >= 0 and tk_cmp(tk_snap(r.upper / r.span, 0.1), 0.1) <= 0
            bool bottom = tk_cmp(tk_snap(tk_delta(math.max(o, c), l, quantum) / r.span, 0.2), 0.2) <= 0 and tk_cmp(tk_snap(r.lower / r.span, 0.1), 0.1) <= 0
            r.pin := tk_cmp(r.comp, 1.2) >= 0 and (top or bottom) ? 1 : 0
    r

tk_period(string tf, int custom) =>
    int fixed = tf == "60" ? 24 : (tf == "240" or tf == "1D" ? 30 : (tf == "1W" ? 54 : (tf == "1M" ? 12 : 0)))
    fixed > 0 ? (custom == 0 or custom == fixed ? fixed : 0) : ((tf == "1" or tf == "5" or tf == "15") and custom >= 1 and custom <= 5000 ? custom : 0)
// TK_CORE_END

int anchor = input.time(0, "History anchor: exact bar open (required)")
int custom = input.int(0, "ATR period: 0 = Excel profile", minval = 0, maxval = 5000)
float quantumInput = input.float(0.0, "Price quantum: 0 = symbol tick", minval = 0.0)
float quantum = tk_cmp(quantumInput, 0.0) == 0 ? syminfo.mintick : quantumInput
int period = tk_period(timeframe.period, custom)
if barstate.isfirst and (anchor == 0 or period == 0 or not chart.is_standard)
    runtime.error("Choose an exact history anchor, standard candles and a supported timeframe/period")
var TKState state = TKState.new()
var bool started = false
TKRow result = TKRow.new()
if barstate.isconfirmed and time >= anchor
    if not started
        if time != anchor
            runtime.error("Exact anchor is absent from loaded history; load it or select an existing bar")
        started := true
    result := tk_step(state, period, quantum, open, high, low, close)
plot(result.baseline, "Previous closed ATR", color = color.blue, linewidth = 2)
plot(result.span, "Candle range", color = color.gray)
plot(result.atr, "ATR after bar", display = display.data_window)
plot(result.tr, "True range", display = display.data_window)
plot(result.seed, "Seed weight", display = display.data_window)
plot(result.raw, "Range ratio", display = display.data_window)
plot(result.comp, "Comparison ratio", display = display.data_window)
plot(na(result.span) ? na : result.length, "Length code", display = display.data_window)
plot(result.dominant < 0 ? na : result.dominant, "Dominant geometry candidate", display = display.data_window)
plot(result.pin < 0 ? na : result.pin, "Pinbar geometry candidate", display = display.data_window)
// A geometry candidate is not a Trex structural reference or a trade signal.
