  "findings": [
    {
      "id": "SA15-01",
      "topic": "reference_candle",
      "status": "supported_bounded_rule",
      "source_ids": [
        177,
        189,
        198,
        203,
        192
      ],
      "conclusion": "An applicable master is covered by a close beyond its shadow extremity. Wick-only excursions do not cover. An existing master has priority over an ATR virtual line. A later contextual master can become active. Body-dominant masters normally align with the incoming move; spinning/shadow references do not require body colour. The 80 percent description is approximate and is not a universal pivot boundary.",
      "implementation": "Keep explicit causal selection and versioned replacement; distinguish a geometric candidate from a confirmed contextual master. The last geometric candidate is only a review prompt, not automatic universal replacement. Keep exact numerical 80 percent as the named engineering/workbook profile.",
      "remaining_gap": "Exhaustive selection/replacement logic, gap variants and virtual-line models are not established by these texts."
    },
    {
      "id": "SA15-02",
      "topic": "incoming_wave",
      "status": "supported_bounded_rule",
      "source_ids": [
        178,
        222,
        246,
        256,
        345,
        186
      ],
      "conclusion": "Three standard candles in one direction and total displacement around three ATR are alternative qualification routes. Opposite candles can be noise only when they do not form a pivot, or form a settlement pivot that price subsequently passes. The exception cannot simply be counted as a third same-direction body, although its shadow can contribute to movement measurement. A depicted 2.4 ATR example is not a universal 2.4 or 2.5 rule.",
      "implementation": "Require explicit endpoints, baseline and as-of timestamps. Keep all intervening candles in review. A machine-detected cover alone cannot certify the semantic no-pivot/settlement label for the entire Trex method. A close beyond an annotated settlement is a conservative engineering proxy and must remain labelled as such.",
      "remaining_gap": "Independent contextual labelling of no-pivot/settlement and highest applicable timeframe is still needed."
    },
    {
      "id": "SA15-03",
      "topic": "exception_confirmation",
      "status": "principle_supported_classifier_incomplete",
      "source_ids": [
        135,
        150,
        166,
        197,
        370
      ],
      "conclusion": "The teacher expressly grants no-next-candle confirmation for a correctly identified exceptional/self-cover pivot, including depicted cases. This principle is not missing. What remains unresolved is an exhaustive numerical classifier proving that an arbitrary silhouette belongs to the exempt subtype, and the exact required-confirmation subtype mentioned in answer 135.",
      "implementation": "Report separately source principle known, observed subtype not established, and entry setup not validated. Preserve the no-automatic-exemption gate for raw shape candidates. Do not phrase the entire source method as requiring later confirmation, or imply the teacher never stated an exemption.",
      "remaining_gap": "Single-pinbar subtype-specific confirmation rule and exact candle sequence; answer 135 refers to course video. The 2017 lesson 2 transcript is not automatically the same material as the 2022 FAQ lesson 3."
    },
    {
      "id": "SA15-04",
      "topic": "post_compression_context",
      "status": "new_source_supported_scope_gate",
      "source_ids": [
        164,
        229,
        370
      ],
      "conclusion": "The cited exclusion concerns a reversal pinbar after the long/spike candle that breaks a compression. It is explicitly not a ban on every pinbar after every spike. Answer 370 associates the poor trend-trade value with the expectation of reaching the third target, while acknowledging first targets may still be touched.",
      "implementation": "Before presenting a trend-reversal/extended-target scenario, require a separate review of whether the preceding long/spike candle is a compression breakout. If confirmed, flag this source-defined exclusion for that scenario. If context is unknown, retain uncertainty. Do not delete the historical level, infer a loss, or ban all shorter scenarios.",
      "remaining_gap": "Compression identification, target numbering and exact lower-timeframe entry are not fully numerically defined in these answers."
    },
    {
      "id": "SA15-05",
      "topic": "geometry_source_conflict",
      "status": "conflict_resolved_by_profile_separation_not_parameter_blending",
      "source_ids": [
        166,
        179,
        185,
        225,
        147,
        180
      ],
      "workbook_refs": [
        "X-CANDLE-B4",
        "X-CANDLE-B7",
        "X-CANDLE-B8"
      ],
      "conclusion": "Workbook B7 requires incoming shadow at least 1 ATR; answer 225 discusses a shadow family beginning at 0.6 ATR. Workbook B8 uses extreme-fifth open/close and range at least 1.2 ATR; answer 166 discusses one-third or one-quarter body illustrations and answer 225 cautions against treating naming ratios as the main concept. These are not identical executable definitions. Opposite noise is measured against whole candle range (answer 147), and body colour is not mandatory for the depicted pinbars (answer 180).",
      "implementation": "Keep the existing frozen Excel-derived numeric screen explicitly named. A failed 1 ATR or extreme-fifth screen must mean not matched to that profile, never invalid under the whole Trex method. If adding the 0.6 ATR family screen, give it a distinct profile and diagnostic-only status; do not silently alter native parity or grant a pivot exemption.",
      "remaining_gap": "Exact taxonomy, threshold inclusivity, baseline choice, and relation of all diagram families to the original workbook require a separate versioned adjudication."
    },
    {
      "id": "SA15-06",
      "topic": "entry_zone_and_probability",
      "status": "supported_boundary",
      "source_ids": [
        131,
        138,
        139,
        152,
        156,
        160,
        291
      ],
      "conclusion": "Recognition, structural timeframe, lower-timeframe arrangement, entry region and outcome are separate. The open-region and hidden-shadow region can differ; hidden-shadow is not an exact universal 50 percent line. Answer 152 postpones the exact retracement depth. Answer 160 addresses paired candles before separately giving a personal observation about zero-noise pinbars. No calibrated probability or profitable strategy is demonstrated.",
      "implementation": "Never convert student questions into source rules, paired-candle confirmation into a single-pinbar rule, or machine transcript into verified exact entry order. Preserve reached-zone/closed-trigger checks and no inferred OHLC intrabar ordering.",
      "remaining_gap": "The 139/152/156 audio responses have not been independently listened to in this audit."
    }
  ],
